{
  "rules": {
    "users": {
      ".read": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'admin'",
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null && (auth.uid === $userId || root.child('users/' + auth.uid + '/role').val() === 'admin')"
      }
    },
    "homeContent": {
      ".read": "true",
      ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'admin'"
    },
    "carts": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null && auth.uid === $userId"
      }
    },
    "products": {
      ".read": "true",
      ".write": "auth != null"
    },
    "orders": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "farms": {
      ".read": "true",
      ".write": "auth != null"
    },
    "farmBookings": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "deletedMockProducts": {
      ".read": "true",
      ".write": "auth != null"
    }
  }
}
